layout {
	tab_template name="deco-tab" {
		pane size=1 borderless=true {
			plugin location="zellij:tab-bar";
		}
		children
		pane size=1 borderless=true {
			plugin location="zellij:status-bar";
		}
	}

	deco-tab name="Prose" edit="prose/25-state-of-guile.tex"

	deco-tab name="Examples" split_direction="vertical" {
		pane name="Shell" size="50%" command="make" {
			args "shell"
		}
		pane name="Editor" edit="examples/guile"
	}

	deco-tab name="Git"

	deco-tab name="Reader" {
		pane command="evince" {
			args "prose/build/main.pdf"
		}
	}
}
